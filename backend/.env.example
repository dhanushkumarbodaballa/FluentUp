# FluentUp AI - Backend Configuration Template
# Copy this file to .env and insert your API keys if you wish to use Cloud AI.
# If no API key is provided, FluentUp runs using its intelligent built-in English+Telugu tutor engine.

# Optional: Groq API Key (Ultra-fast cloud models)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Google Gemini API Key
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Port & Host
PORT=8000
HOST=127.0.0.1
